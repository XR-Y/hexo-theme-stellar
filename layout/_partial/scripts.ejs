<%

function custom_inject() {
  const currentPath = page.path || '';
  const isTaxonomyPath = currentPath.startsWith('archives/')
    || currentPath === 'archives/'
    || currentPath.startsWith('tags/')
    || currentPath === 'tags/'
    || currentPath.startsWith('categories/')
    || currentPath === 'categories/';
  const isListLike = is_home() || is_category() || is_tag() || is_archive() || isTaxonomyPath || ['index_topic', 'notebooks', 'notes', '404', 'tags', 'categories'].includes(page.layout);
  function shouldIncludeScriptInject(item) {
    if (typeof item !== 'string') {
      return true;
    }
    if (item.includes('cdn.jsdmirror.com/npm/katex') || item.includes('cdn.jsdelivr.net/npm/katex') || item.includes('unpkg.com/katex')) {
      return !isListLike;
    }
    return true;
  }
  var el = '';
  for (let item of (config.inject?.script || [])) {
    if (shouldIncludeScriptInject(item)) {
      el += item;
    }
  }
  for (let item of (theme.inject?.script || [])) {
    if (shouldIncludeScriptInject(item)) {
      el += item;
    }
  }
  for (let item of (page.inject?.script || [])) {
    if (shouldIncludeScriptInject(item)) {
      el += item;
    }
  }
  return el;
}

%>
<%- partial('scripts/defines') %>
<%- partial('scripts/utils') %>
<%- partial('scripts/sidebar') %>
<%- partial('scripts/tagtree') %>
<%- partial('scripts/lazyload') %>

<!-- required -->
<script src="<%- url_for(`${theme.stellar.main_js}?v=${stellar_info('version')}`) %>" defer></script>

<%- partial('scripts/theme') %>

<!-- optional -->
<%- partial('comments/script') %>

<%- partial('scripts/services') %>
<%- partial('../_plugins/index') %>

<!-- inject -->
<%- custom_inject() %>
