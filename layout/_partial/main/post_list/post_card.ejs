<%
const poster = post.poster;
const listIndex = typeof list_index === 'number' ? list_index : Number.MAX_SAFE_INTEGER;
const coverListIndex = typeof cover_list_index === 'number' ? cover_list_index : Number.MAX_SAFE_INTEGER;
var obj = {
  image: post.cover
};
if (poster) {
  obj.headline = poster.headline;
  obj.topic = poster.topic;
  obj.caption = poster.caption;
  obj.color = poster.color;
}
function div_default() {
  var el = '';
  var cover_url = null;
  var category_meta = '';
  var excerpt_limit = Math.max(48, theme.article.auto_excerpt || 84);
  var cover_attrs = '';

  function can_resize_cover(url) {
    return /^https?:\/\/(?:b2\.xryuu\.com|s2\.loli\.net)\//i.test(url || '');
  }

  function wsrv_url(url, width) {
    var normalized = (url || '').replace(/^https?:\/\//i, '');
    return 'https://wsrv.nl/?url=' + encodeURIComponent(normalized) + '&w=' + width + '&fit=cover&output=webp&q=82';
  }

  function build_cover_attrs(url, title) {
    var attrs = [];
    var loading = coverListIndex < 2 ? 'eager' : 'lazy';
    var fetchpriority = coverListIndex === 0 ? 'high' : 'auto';

    attrs.push('alt="' + (title || 'post cover') + '"');
    attrs.push('width="448"');
    attrs.push('height="252"');
    attrs.push('decoding="async"');
    attrs.push('loading="' + loading + '"');
    attrs.push('fetchpriority="' + fetchpriority + '"');
    attrs.push('sizes="(max-width: 768px) min(100vw - 4rem, 420px), 224px"');
    attrs.push('referrerpolicy="no-referrer"');

    if (can_resize_cover(url)) {
      attrs.push('src="' + wsrv_url(url, 448) + '"');
      attrs.push('srcset="' + wsrv_url(url, 448) + ' 448w, ' + wsrv_url(url, 672) + ' 672w, ' + wsrv_url(url, 896) + ' 896w"');
      attrs.push('data-origin-src="' + url + '"');
    } else {
      attrs.push('src="' + url + '"');
    }

    return attrs.join(' ');
  }

  function compact_excerpt(raw) {
    if (!raw) return '';
    var text = strip_html(raw).replace(/\s+/g, ' ').trim();
    if (!text.length) return '';
    return truncate(text, { length: excerpt_limit });
  }

  // 封面
  if (obj.image || theme.article.auto_cover) {
    if (obj.image != undefined) {
      if (obj.image.includes('/')) {
        cover_url = obj.image;
      } else {
        cover_url = 'https://source.unsplash.com/1280x640/?' + obj.image;
      }
    } else {
      // 自动以 tags 作为关键词搜索封面
      if (post.tags) {
        var params = '';
        post.tags.reverse().forEach((tag, i) => {
          if (i > 0) {
            params += ',';
          }
          params += tag.name;
        });
        cover_url = 'https://source.unsplash.com/1280x640/?' + params;
      } else {
        cover_url = 'https://source.unsplash.com/random/1280x640';
      }
    }
  }

  if (post.categories && post.categories.length > 0) {
    var cats = [];
    post.categories.forEach((cat) => {
      cats.push(cat.name);
    });
    if (cats.length > 0) {
      let lastCat = cats[cats.length - 1];
      category_meta += '<span class="cap breadcrumb"' + category_color(lastCat) + '>';
      category_meta += icon('default:category');
      category_meta += `<span>${lastCat}</span>`;
      category_meta += '</span>';
    }
  }

  el += '<article class="md-text' + (cover_url ? ' with-cover' : '') + '">';

  if (cover_url) {
    cover_attrs = build_cover_attrs(cover_url, post.title);
    el += '<div class="post-cover compact">';
    el += '<img ' + cover_attrs + '/>';
    el += '</div>';
  }

  if (cover_url) {
    el += '<div class="post-main">';
  }

  // 标题
  el += '<h2 class="post-title">';
  el += post.title ? post.title : date(post.date, config.date_format);
  el += '</h2>';

  // 摘要
  el += '<div class="excerpt';
  if (theme.plugins.heti?.enable) {
    el += ' heti';
  }
  el += '">';
  el += '<p>';
  if (post.excerpt) {
    el += compact_excerpt(post.excerpt);
  } else if (post.description) {
    el += compact_excerpt(post.description);
  } else if (post.content && theme.article.auto_excerpt > 0) {
    el += compact_excerpt(post.content);
  }
  el += '</p>';
  el += '</div>';

  // meta
  el += '<div class="meta cap">';
  el += '<span class="cap" id="post-meta">';
  el += icon('default:calendar')
  // time
  el += `<time datetime="${date_xml(post.date)}">${date(post.date, config.date_format)}</time>`
  el += '</span>';
  if (category_meta) {
    el += category_meta;
  }
  // 字数统计
  el += '<span class="post-count" style="font-size: 12px; color: var(--text-p2);">' + '✒️ ' + wordcount(post.content) + ' 字</span>';
  if (post.sticky) {
    el += `<span class="pin">${icon('default:pin')}</span>`
  }
  el += '</div>';
  if (cover_url) {
    el += '</div>';
  }
  el += '</article>';
  return el;
}
function div_photo() {
  var el = '';
  var position = '';
  if (obj.headline || obj.topic || obj.caption) {
    if (obj.topic) {
      position = 'top';
    } else {
      position = 'bottom';
    }
  }
  el += '<div class="cover" position="' + position + '">';
  el += '<img src="' + obj.image + '" loading="lazy" decoding="async" referrerpolicy="no-referrer"/>';
  if (position.length > 0) {
    el += '<div class="cover-info" position="' + position + '"';
    if (obj.color) {
      el += 'style="color:' + obj.color + '"';
    }
    el += '>';
    if (obj.topic) {
      el += '<div class="text topic">' + obj.topic + '</div>';
    }
    if (obj.headline) {
      el += '<div class="text headline">' + obj.headline + '</div>';
    }
    if (obj.caption) {
      el += '<div class="text caption">' + obj.caption + '</div>';
    }
    el += '</div>';

  }
  el += '</div>';
  return el;
}
function div() {
  if (obj.image && obj.image.length > 0 && obj.headline != undefined) {
    return div_photo();
  }
  return div_default();
}
%>
<%- div() %>
