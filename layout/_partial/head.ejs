<%
function generate_title() {
  if (page.wiki) {
    const proj = theme.wiki.tree[page.wiki]
    const wiki = proj?.name || page.wiki
    if (page.title) {
      return wiki + __('symbol.colon') + page.title + ' - ' + config.title;
    } else {
      return wiki + ' - ' + config.title;
    }
  } else {
    if (page.title) {
      return page.title + ' - ' + config.title;
    } else if (page.category) {
      return __('btn.category') + __('symbol.colon') + page.category + ' - ' + config.title;
    } else if (page.tag) {
      return __('btn.tag') + __('symbol.colon') + page.tag + ' - ' + config.title;
    }
  }
  return config.title;
}
function generate_description() {
  if (theme.open_graph && theme.open_graph.enable) {
    return '';
  }
  if (page.wiki) {
    const proj = theme.wiki.tree[page.wiki]
    if (proj?.description) {
      return '<meta name="description" content="' + proj.description + '">'
    }
  }
  if (page.description || page.excerpt || page.content) {
    return '<meta name="description" content="' + truncate(strip_html(page.description || page.excerpt || page.content), {length: 150}) + '">';
  }
  return '<meta name="description" content="' + config.description + '">';
}
function generate_keywords() {
  if (page.keywords && page.keywords.length > 0) {
    return '<meta name="keywords" content="' + page.keywords + '">';
  } else if (page.tags && page.tags.length > 0) {
    return '<meta name="keywords" content="' + page.tags.map(tag => tag.name).join(',') + '">';
  } else if (config.keywords && config.keywords.length > 0) {
    return '<meta name="keywords" content="' + config.keywords + '">';
  } else {
    return '';
  }
}

function generate_robots() {
  const IS_BACKUP = process.env.IS_BACKUP === 'true';
  if (IS_BACKUP) {
    return '<meta name="robots" content="noindex, nofollow">';
  }
  if (is_home() == true) {
    return '';
  }
  if (page.robots) {
    return '<meta name="robots" content="' + page.robots + '">';
  }
}
function og_args() {
  var args = {};
  if (theme.open_graph.twitter_id) {
    args.twitter_id = theme.open_graph.twitter_id;
  }
  if (page.layout == 'post' && page.cover) {
    args.twitter_card = 'summary_large_image';
  }
  args.image = config.avatar || (config.email ? gravatar(config.email) : null);
  return Object.assign(args, page.open_graph);
}

function preconnect() {
  var el = '';
  for (let href of (theme.preconnect || [])) {
    el += `<link rel="preconnect" href="${href}" crossorigin>`;
  }
  return el;
}

function render_async_stylesheet(href) {
  return `<link rel="preload" as="style" href="${href}"><link rel="stylesheet" href="${href}"><noscript><link rel="stylesheet" href="${href}"></noscript>`;
}

function render_home_txmap_loader() {
  return `<script>(function(){function loadTxmap(){if(window.__txmapLoaderStarted)return;window.__txmapLoaderStarted=true;var s=document.createElement('script');s.src='/js/services/txmap.js';s.async=true;s.setAttribute('data-pjax','');document.head.appendChild(s);}function watch(){var target=document.getElementById('welcome-info');if(!target){if('requestIdleCallback'in window){requestIdleCallback(loadTxmap,{timeout:2500});}else{setTimeout(loadTxmap,1800);}return;}if('IntersectionObserver'in window){var io=new IntersectionObserver(function(entries){if(entries.some(function(entry){return entry.isIntersecting;})){io.disconnect();loadTxmap();}},{rootMargin:'280px 0px 280px 0px'});io.observe(target);}else{if('requestIdleCallback'in window){requestIdleCallback(loadTxmap,{timeout:2000});}else{setTimeout(loadTxmap,1600);}}}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',watch,{once:true});}else{watch();}})();</script>`;
}


function render_ai_summary_bootstrap() {
  const articleLayouts = ['post', 'page', 'wiki', 'note'];
  if (articleLayouts.includes(page.layout)) {
    return `<script>document.documentElement.classList.add('js-ai-summary');</script>`;
  }
  return '';
}

function render_vote_preconnect() {
  const voteApi = theme.data_services?.vote?.api;
  const hasVoteWidget = page.content?.includes('tag-plugin ds-vote')
    || page.content?.includes('ds-memos')
    || (page.layout === 'post' && page.vote !== false && !!voteApi);
  if (!hasVoteWidget || typeof voteApi !== 'string') {
    return '';
  }
  const origin = voteApi.replace(/\/api\/.*$/, '');
  if (!/^https?:\/\//.test(origin)) {
    return '';
  }
  return `<link rel="preconnect" href="${origin}" crossorigin>`;
}

function render_memos_vote_api() {
  const voteApi = theme.data_services?.vote?.api;
  if (!page.content?.includes('ds-memos') || !voteApi) {
    return '';
  }
  return `<script>window.stellar=window.stellar||{};window.stellar.memosVoteApi=${JSON.stringify(voteApi)};</script>`;
}

function custom_inject() {
  const articleLayouts = ['post', 'page', 'wiki', 'note'];
  const isArticleLike = articleLayouts.includes(page.layout);
  const currentPath = page.path || '';
  const isTaxonomyPath = currentPath.startsWith('archives/')
    || currentPath === 'archives/'
    || currentPath.startsWith('tags/')
    || currentPath === 'tags/'
    || currentPath.startsWith('categories/')
    || currentPath === 'categories/';
  const isListLike = is_home() || is_category() || is_tag() || is_archive() || isTaxonomyPath || ['index_topic', 'notebooks', 'notes', '404', 'tags', 'categories'].includes(page.layout);

  function shouldIncludeHeadInject(item) {
    if (typeof item !== 'string') {
      return true;
    }
    const usesPoemWidget = is_home()
      || page.layout === 'post'
      || page.layout === 'tags'
      || page.layout === 'categories'
      || is_category()
      || is_tag()
      || is_archive()
      || isTaxonomyPath;
    if (item.includes('/css/callouts_blocks.css') || item.includes('/css/table_dataview.css')) {
      return !isListLike;
    }
    if (item.includes('/css/article_refine.css')) {
      return isArticleLike;
    }
    if (item.includes('cdn.jsdmirror.com/npm/katex') || item.includes('cdn.jsdelivr.net/npm/katex') || item.includes('unpkg.com/katex')) {
      return !isListLike;
    }
    if (item.includes('/js/services/txmap.js')) {
      return is_home();
    }
    if (item.includes('webapi.amap.com') || item.includes('a.amap.com') || item.includes('vdata.amap.com')) {
      return is_home();
    }
    if (item.includes('/js/services/jinrishici.js')) {
      return usesPoemWidget;
    }
    if (item.includes('/js/services/aisummary.js')) {
      return isArticleLike;
    }
    if (item.includes('/js/services/link_icon.js')) {
      return isArticleLike;
    }
    return true;
  }

  function render_head_inject_list(items) {
    let html = '';
    for (let item of (items || [])) {
      if (!shouldIncludeHeadInject(item)) {
        continue;
      }
      if (typeof item === 'string' && item.includes('/css/jinkai_vendor.css') && is_home()) {
        html += render_async_stylesheet('/css/jinkai_vendor.css');
      } else if (typeof item === 'string' && item.includes('/js/services/txmap.js') && is_home()) {
        html += render_home_txmap_loader();
      } else if (typeof item === 'string' && (item.includes('webapi.amap.com') || item.includes('a.amap.com') || item.includes('vdata.amap.com')) && is_home()) {
        continue;
      } else {
        html += item;
      }
    }
    return html;
  }

  return render_head_inject_list(config.inject?.head)
    + render_head_inject_list(theme.inject?.head)
    + render_head_inject_list(page.inject?.head);
}

function generate_canonical() {
  const originalHost = theme.canonical.originalHost || '';
  if (originalHost.length > 0) {
    var path = pretty_url(page.path) || '/';
    if (path.startsWith('/404') || path.startsWith('404')) {
      return '';
    }
    if (path.endsWith('.html') && path.length > 5) {
      path = path.split('.html')[0];
    }
    return `<link rel="canonical" href="https://${originalHost}${path}">`;
  }
  return '';
}

%>

<head>
  <meta charset="utf-8">
  <meta name="hexo-theme" content="<%- stellar_info('tree') %>" theme-name="<%- stellar_info('name') %>" theme-version="<%- stellar_info('version') %>">
  <%- generate_canonical() %>
  <%- generate_robots() %>
  <%- meta_generator() %>
  <meta http-equiv='x-dns-prefetch-control' content='on' />
  <%- preconnect() %>
  <meta name="renderer" content="webkit">
  <meta name="force-rendering" content="webkit">
  <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1">
  <meta name="HandheldFriendly" content="True" >
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000">
  <meta name="theme-color" content="#f9fafb">
  <title><%- generate_title() %></title>
  <%- render_vote_preconnect() %>
  <%- render_memos_vote_api() %>

  <% if (theme.open_graph && theme.open_graph.enable) { %>
    <%- open_graph(og_args()) %>
  <% } %>
  <%- generate_description() %>
  
  <%- generate_keywords() %>

  <!-- feed -->
  <% if (config.feed && config.feed.path) { %>
    <%- feed_tag(config.feed.path, {title: config.title}) %>
  <% } %>

  <link rel="stylesheet" href="<%- url_for(`${theme.stellar.main_css}?v=${stellar_info('version')}`) %>">


  <% if (config.favicon) { %>
    <%- favicon_tag(config.favicon) %>
  <% } %>

  <% if (config.highlight && config.highlight.enable == true && config.highlight.hljs == true) { %>
    <%- css(theme.style.codeblock.highlightjs_theme) %>
  <% } %>

  <%- json_ld() %>
  <%- render_ai_summary_bootstrap() %>
  <% if (['post', 'page', 'wiki', 'note'].includes(page.layout)) { %><style>.js-ai-summary #summary:not([data-summary-enhanced="true"]){min-height:11.5rem;color:transparent!important;user-select:none;background:#f5f5f5;border:1px solid #cfe6f3;border-radius:.5rem;padding:.5rem;line-height:1.3;margin:1rem 0}.js-ai-summary #summary:not([data-summary-enhanced="true"]) *{color:transparent!important}@media (prefers-color-scheme: dark){.js-ai-summary #summary:not([data-summary-enhanced="true"]){background:#1B1B1B;border:1px solid #555}}</style><% } %>
  <%- custom_inject() %>
</head>



