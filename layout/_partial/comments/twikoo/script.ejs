<script type="module">
  const el = document.getElementById('twikoo_container');
  const enableLazyload = <%= theme.comments.lazyload ?? false %>;
  const twikooConfig = Object.assign({}, <%- JSON.stringify(theme.comments.twikoo) %>, {
    js: 'https://registry.npmmirror.com/twikoo/1.6.44/files/dist/twikoo.min.js'
  });
  let twikooScriptPromise = null;
  let twikooInitialized = false;

  function ensureTwikooScript() {
    if (twikooScriptPromise) {
      return twikooScriptPromise;
    }
    twikooScriptPromise = utils.js(twikooConfig.js, {defer: true});
    return twikooScriptPromise;
  }

  function scheduleTwikooPreload() {
    if (!el || !enableLazyload) return;
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(() => ensureTwikooScript(), { timeout: 2000 });
    } else {
      window.setTimeout(() => ensureTwikooScript(), 1200);
    }
  }

  if (!enableLazyload || !('IntersectionObserver' in window)) {
    load_twikoo();
  } else {
    scheduleTwikooPreload();
    const observer = new IntersectionObserver((entries) => {
      if (entries[0] && entries[0].isIntersecting) {
        load_twikoo();
        observer.disconnect();
      }
    }, {
      rootMargin: '900px 0px 900px 0px'
    });
    observer.observe(el);
  }

  function load_twikoo() {
    if (!el || twikooInitialized) return;
    twikooInitialized = true;
    ensureTwikooScript().then(function () {
      const path = el.getAttribute('comment_id') ?? decodeURI(window.location.pathname);
      twikoo.init(Object.assign(twikooConfig, {
        el: '#twikoo_container',
        path: path,
      }));
    });
  }
</script>
